# Test Environment Configuration
# Copy this file to .env.testing and adjust values for your local environment
# This file is used by phpunit.xml via env var fallbacks

APP_ENV=testing
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4
CACHE_STORE=array

# Database (MySQL by default)
DB_CONNECTION=mysql
DB_DATABASE=transport_testing
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# Alternative: SQLite (uncomment and comment MySQL above)
# DB_CONNECTION=sqlite
# DB_DATABASE=:memory:

MAIL_MAILER=array
PULSE_ENABLED=false
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
TELESCOPE_ENABLED=false